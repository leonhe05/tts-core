<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leon.infrastructure.mapper.RecordMapper">

    <select id="getTodayWords">
        SELECT sum(length)
        FROM record
        WHERE ip  = #{ip}
        and create_time >= date(now())
    </select>

</mapper>